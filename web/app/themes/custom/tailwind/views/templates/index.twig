{% extends 'layouts/base.twig' %}

{% block content %}
    <div class="mx-auto max-w-5xl px-4 py-12">
        <div class="space-y-10">
            {% for post in posts %}
                <article>
                    <h2 class="text-2xl font-semibold">
                        <a href="{{ post.link }}" class="hover:text-gray-500">{{ post.title }}</a>
                    </h2>
                    <p class="mt-1 text-sm text-gray-500">{{ post.date }}</p>
                    <div class="mt-3 text-gray-700">{{ post.preview }}</div>
                </article>
            {% endfor %}
        </div>

        <div class="mt-12">
            {{ function('the_posts_pagination') }}
        </div>
    </div>
{% endblock %}
