{#
  Props: label (string, requis)
         variant (primary|secondary|ghost, default: primary)
         size (sm|md|lg, default: md)
         url (optionnel — rend <a> au lieu de <button>)
         disabled (bool, default: false — ignoré si url est renseigné)
#}
{% set variants = {
    primary: 'bg-primary text-text-inverse hover:bg-primary-hover',
    secondary: 'bg-transparent border border-primary text-primary hover:bg-surface-alt',
    ghost: 'bg-transparent text-text hover:bg-surface-alt',
} %}
{% set sizes = {
    sm: 'px-3 py-1.5 text-sm',
    md: 'px-4 py-2 text-base',
    lg: 'px-6 py-3 text-lg',
} %}
{% set classes = 'inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-50 disabled:pointer-events-none '
    ~ variants[variant|default('primary')] ~ ' ' ~ sizes[size|default('md')] %}
{% if url %}
    <a href="{{ url }}" class="{{ classes }}">{{ label }}</a>
{% else %}
    <button type="button" class="{{ classes }}"{{ disabled ? ' disabled' }}>{{ label }}</button>
{% endif %}
