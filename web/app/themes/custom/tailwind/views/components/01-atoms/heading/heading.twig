{#
  Props: text (string, requis)
         level (1-6, default: 2 — le <hN> sémantique rendu)
         size (xs|sm|md|lg|xl|2xl, optionnel — taille visuelle, découplée du
               niveau sémantique ; si absent, dérivée de level)
#}
{% set level = level|default(2) %}
{% set level_to_size = { 1: '2xl', 2: 'xl', 3: 'lg', 4: 'md', 5: 'sm', 6: 'xs' } %}
{% set sizes = {
    xs: 'text-lg font-semibold',
    sm: 'text-xl font-semibold',
    md: 'text-2xl font-bold',
    lg: 'text-3xl font-bold',
    xl: 'text-4xl font-bold tracking-tight',
    '2xl': 'text-5xl font-bold tracking-tight',
} %}
<h{{ level }} class="{{ sizes[size|default(level_to_size[level])] }}">{{ text }}</h{{ level }}>
