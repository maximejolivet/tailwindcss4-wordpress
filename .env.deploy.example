# Déploiement o2switch (make deploy / workflow GitHub Actions)
# Copier en .env.deploy (déjà ignoré par .gitignore, comme .env) et compléter.

DEPLOY_SSH_HOST='xxx.o2switch.net'
DEPLOY_SSH_PORT='22'
DEPLOY_SSH_USER='cpanel_user'

# Chemin du dépôt git côté serveur (cPanel Git Version Control — PAS le
# document root du site, cf. .cpanel.yml pour la copie vers le doc root)
DEPLOY_PROJECT_PATH='/home/cpanel_user/repositories/tailwindcss4-wordpress'

# Binaire PHP à utiliser côté serveur (ALT-PHP cPanel, ex. PHP 8.4)
DEPLOY_PHP_BIN='/opt/alt/php84/usr/bin/php'

# Document root réel du site (public_html ou dossier de domaine additionnel)
DEPLOY_DOCROOT='/home/cpanel_user/public_html'
DEPLOY_DOMAIN='https://example.com'
DEPLOY_DB_NAME=''
DEPLOY_DB_USER=''
DEPLOY_DB_PASSWORD=''
